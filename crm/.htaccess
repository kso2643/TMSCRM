# CRM pages (v11.56) — fresh pages without overloading the hosting.
#
# Pages (.html / .txt / .json) are always checked with the server, so nobody sees an old page.
# Scripts and styles are reused for up to 1 hour without asking: every update gives them a new
# version tag (?v=…) in the pages, so a new update still arrives at once. (Asking the server for
# every script on every page — the first version of this file — made 40–60 requests per page
# and could exhaust the hosting's request limit: "504 Gateway Time-out".)
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|txt|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|ico|woff2?|ttf|otf|mp3|wav|ogg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # the offline helper itself is checked on every visit
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>
